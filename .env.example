PORT=3000
PUBLIC_BASE_URL=http://31.70.115.79:3000

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Creator Hub
# Twitch uses an app access token (Client Credentials flow).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# TikTok is monitored locally by the built-in provider.
# No TikTok API key, cookies or external status endpoint are required.
# Optional tuning only:
TIKTOK_LANGUAGE=de
TIKTOK_REGION=DE
TIKTOK_TIMEOUT_MS=12000

# Instagram public-post monitoring is keyless-first.
# Public profile data is checked conservatively to reduce login-wall/rate-limit pressure.
# The Meta Graph values below are OPTIONAL fallbacks only; they are not required.
CREATOR_INSTAGRAM_MIN_FETCH_SECONDS=600
INSTAGRAM_PUBLIC_APP_ID=936619743392459
INSTAGRAM_PUBLIC_ASBD_ID=198387
INSTAGRAM_GRAPH_ACCESS_TOKEN=
INSTAGRAM_GRAPH_IG_USER_ID=
INSTAGRAM_GRAPH_VERSION=v26.0

# Bluesky public posts use public.api.bsky.app and need no credentials.

# X public-post monitoring is keyless-first via X/Twitter's public syndication timeline.
# X_BEARER_TOKEN is an OPTIONAL fallback only; it is not required.
CREATOR_X_MIN_FETCH_SECONDS=180
X_BEARER_TOKEN=

# Provider polling: 60-900 seconds. 90 is a balanced default.
# Instagram/X additionally respect their minimum fetch intervals above.
CREATOR_POLL_SECONDS=90
CREATOR_DEFAULT_TIMEZONE=Europe/Berlin

# Use a long random value in real deployments.
SESSION_SECRET=change-me
