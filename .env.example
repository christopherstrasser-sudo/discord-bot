PORT=3000
PUBLIC_BASE_URL=http://31.70.115.79:3000

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Creator Hub
# Twitch uses an app access token (Client Credentials flow).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# TikTok is monitored locally by the built-in provider.
# No TikTok API key, cookies or external status endpoint are required.
# Optional tuning only:
TIKTOK_LANGUAGE=de
TIKTOK_REGION=DE
TIKTOK_TIMEOUT_MS=12000

# Instagram public posts:
# ORBIT no longer scrapes Instagram directly. Configure one managed read provider.
# HikerAPI is the preferred provider; ScrapeCreators can be used as fallback.
# Dashboard users still only enter the public Instagram handle.
HIKERAPI_KEY=
SCRAPECREATORS_API_KEY=
CREATOR_INSTAGRAM_MIN_FETCH_SECONDS=300

# Optional ORBIT-owned social relay. When configured, it has highest priority.
ORBIT_SOCIAL_RELAY_URL=
ORBIT_SOCIAL_RELAY_TOKEN=

# SoundCloud public artist uploads are monitored keyless via the public profile/web client.
# No SoundCloud Pro account, login or API credentials are required.
SOUNDCLOUD_TIMEOUT_MS=15000
CREATOR_SOUNDCLOUD_MIN_FETCH_SECONDS=120

# Bluesky public posts use public.api.bsky.app and need no credentials.

# X public posts use the server-side x.md read relay.
# No X login or X API key is required for the default path.

# Provider polling: 60-900 seconds. 90 is a balanced default.
CREATOR_POLL_SECONDS=90
CREATOR_DEFAULT_TIMEZONE=Europe/Berlin

# Use a long random value in real deployments.
SESSION_SECRET=change-me
