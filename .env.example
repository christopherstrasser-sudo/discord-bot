PORT=3000
PUBLIC_BASE_URL=http://31.70.115.79:3000

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Creator Hub
# Twitch uses an app access token (Client Credentials flow).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# TikTok is monitored locally by the built-in provider.
# No TikTok API key, cookies or external status endpoint are required.
# Optional tuning only:
TIKTOK_LANGUAGE=de
TIKTOK_REGION=DE
TIKTOK_TIMEOUT_MS=12000

# Instagram public posts:
# Primary path is browserless TLS/HTTP impersonation via impit.
# No Chrome/Edge process, Instagram login or customer API key is required.
INSTAGRAM_PUBLIC_APP_ID=936619743392459
INSTAGRAM_PUBLIC_ASBD_ID=198387

# Optional production relay/provider fallbacks.
# Customers never enter these values in the dashboard; they are backend-only.
RAKU_SOCIAL_RELAY_URL=
RAKU_SOCIAL_RELAY_TOKEN=
SCRAPECREATORS_API_KEY=

# Optional official Meta Graph fallback retained for professional-account setups.
INSTAGRAM_GRAPH_ACCESS_TOKEN=
INSTAGRAM_GRAPH_IG_USER_ID=
INSTAGRAM_GRAPH_VERSION=v26.0

# Bluesky public posts use public.api.bsky.app and need no credentials.

# X public posts use the server-side x.md read relay.
# No X login or X API key is required for the default path.

# Provider polling: 60-900 seconds. 90 is a balanced default.
CREATOR_POLL_SECONDS=90
CREATOR_DEFAULT_TIMEZONE=Europe/Berlin

# Use a long random value in real deployments.
SESSION_SECRET=change-me