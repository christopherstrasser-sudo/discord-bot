PORT=3000
PUBLIC_BASE_URL=http://31.70.115.79:3000

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Creator Hub
# Twitch uses an app access token (Client Credentials flow).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Reliable TikTok monitoring is adapter-based.
# The endpoint receives a username either via {username} in the URL or ?username=...
# It can expose Live + Upload capabilities in one response, for example:
# {
#   "exists": true,
#   "creator": "Rakulein",
#   "avatar": "https://...",
#   "live": true,
#   "liveId": "123",
#   "title": "Live title",
#   "url": "https://www.tiktok.com/@rakulein/live",
#   "thumbnail": "https://...",
#   "startedAt": "2026-09-15T12:00:00Z",
#   "viewers": 123,
#   "latestUpload": {
#     "id": "7481234567890",
#     "title": "New TikTok",
#     "url": "https://www.tiktok.com/@rakulein/video/7481234567890",
#     "thumbnail": "https://...",
#     "publishedAt": "2026-09-15T11:00:00Z",
#     "views": 456
#   }
# }
TIKTOK_STATUS_ENDPOINT=

# Provider polling: 60-900 seconds. 90 is a balanced default.
CREATOR_POLL_SECONDS=90
CREATOR_DEFAULT_TIMEZONE=Europe/Berlin

# Use a long random value in real deployments.
SESSION_SECRET=change-me
