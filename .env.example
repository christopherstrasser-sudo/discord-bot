PORT=3000
PUBLIC_BASE_URL=http://31.70.115.79:3000

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Creator Hub
# Twitch uses an app access token (Client Credentials flow).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Reliable TikTok monitoring is intentionally adapter-based.
# Endpoint must return JSON like:
# {"live":true,"liveId":"123","title":"Live title","url":"https://...","creator":"Name","viewers":123}
# Either use a URL containing {username} or an endpoint that accepts ?username=...
TIKTOK_STATUS_ENDPOINT=

# Provider polling: 60-900 seconds. 90 is a balanced default.
CREATOR_POLL_SECONDS=90
CREATOR_DEFAULT_TIMEZONE=Europe/Berlin

# Use a long random value in real deployments.
SESSION_SECRET=change-me
